#!/usr/bin/env node
// bin/flipd
import { paths } from '../lib/paths.mjs';

const COMMANDS = ['serve', 'add', 'check', 'run', 'rollback', 'status', 'log', 'env', 'remove', 'account'];
const USAGE = `usage: flipd <command> [args]

  serve                              run the service (systemd does this)
  add <git-url> [--name N] [--branch B] [--root R] [--build C] [--deploy C] [--key PATH]
  check <name> [--set-remote]        verify config, key, clone, and remote head
  run <name> [--now]                 queue a forced build now (--now skips STOP)
  rollback <name> [--now]            queue a rollback (--now skips STOP)
  status [name]                      one row per repo
  log <name> [--follow]              print or tail the latest attempt log
  env <name> build|deploy [--set K=V] [--unset K]
  remove <name>                      delete the repo's config file
  account add <host> --kind github|forgejo|gitea [--api URL] [--ssh-port N]  < token-file
  account list | account remove <host>
`;

const [cmd, ...args] = process.argv.slice(2);
if (!cmd || cmd === '--help' || cmd === '-h' || !COMMANDS.includes(cmd)) {
  process.stderr.write(USAGE);
  process.exit(cmd && cmd !== '--help' && cmd !== '-h' ? 2 : 0);
}
const mod = await import(`../lib/cli/${cmd}.mjs`);
let code;
try {
  code = await mod.default(args, { paths: paths(), stdout: process.stdout, stderr: process.stderr, stdin: process.stdin });
} catch (e) {
  // A bad name, a missing config, a refused socket: one line, not a stack.
  process.stderr.write(`${e.code === 'ENOENT' ? `not found: ${e.path}` : e.message}\n`);
  process.exit(1);
}
process.exit(code ?? 0);
