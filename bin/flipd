#!/usr/bin/env node
// bin/flipd
import { paths } from '../lib/paths.mjs';

const COMMANDS = ['serve', 'add', 'check', 'run', 'trigger', 'rollback', 'cancel', 'pause', 'resume', 'status', 'history', 'log', 'env', 'domain', 'remove', 'upgrade', 'account'];
const USAGE = `usage: flipd <command> [args]

  serve                              run the service (systemd does this)
  add <git-url> [--name N] [--branch B] [--root R] [--build C] [--deploy C] [--key PATH]
  check <name> [--set-remote]        verify config, key, clone, and remote head
  run <name> [--now]                 queue a forced build now (--now skips STOP)
  trigger <name> [--wait]            queue a build as a webhook would (--wait: exit with the outcome)
  rollback <name> [--to R] [--now]   queue a rollback, to previous or to release/sha R (--now skips STOP)
  cancel <name>                      stop the running attempt and drop everything queued for it
  pause <name> [--reason TEXT]       refuse pushes and triggers until resume (run and rollback still work)
  resume <name>                      accept pushes and triggers again
  status [name] [--json]             one row per repo (--json: the same, as an object)
  history <name> [--limit N] [--json] past attempts, newest first
  log <name> [attempt] [--follow]    print or tail an attempt log (the latest by default)
  env <name> build|deploy [--set K=V] [--unset K]
  domain add <name> <host>... [--port N | --root DIR] [--spa]   put the repo on a hostname
  domain remove <name> [<host>...]   drop a hostname, or all of them
  domain list [name]                 hostnames per repo
  remove <name>                      delete the repo's config file
  upgrade [--restart-only]           wait for idle, pull the service clone, restart (--restart-only: skip the pull)
  account add <host> --kind github|forgejo|gitea [--api URL] [--ssh-port N]  < token-file
  account list | account remove <host>
`;

const [cmd, ...args] = process.argv.slice(2);
if (!cmd || cmd === '--help' || cmd === '-h' || !COMMANDS.includes(cmd)) {
  process.stderr.write(USAGE);
  process.exit(cmd && cmd !== '--help' && cmd !== '-h' ? 2 : 0);
}
const mod = await import(`../lib/cli/${cmd}.mjs`);
let code;
try {
  code = await mod.default(args, { paths: paths(), stdout: process.stdout, stderr: process.stderr, stdin: process.stdin });
} catch (e) {
  // A bad name, a missing config, a refused socket: one line, not a stack.
  process.stderr.write(`${e.code === 'ENOENT' ? `not found: ${e.path}` : e.message}\n`);
  process.exit(1);
}
process.exit(code ?? 0);
